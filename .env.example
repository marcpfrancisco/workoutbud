NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase calls this "Publishable Key" in the dashboard — map it to ANON_KEY here
# Found at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key_here

# Supabase project ID — used by `npm run gen:types`
# Found at: https://supabase.com/dashboard/project/_/settings/general
PROJECT_ID=your_supabase_project_id
